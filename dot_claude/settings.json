{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "4096",
    "MAX_THINKING_TOKENS": "1024",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": ["Bash(git add:*)", "Bash(git commit -m :*)", "Bash(tree:*)"],
    "deny": [
      "Read(**.ssh/**)",
      "Read(.gnupg/**)",
      "Read(.aws/**)",
      "Read(.docker/config.json)",
      "Read(secrets**)",
      "Read(.secrets**)",
      "Read(.env**)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(id_ecdsa*)",
      "Read(*.crt)",
      "Read(*.csr)",
      "Read(.devcontainer/devcontainer.env)",
      "Read(plan.file)"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "iac-platform@dig": true,
    "punkt-designsystem@dig": true
  },
  "extraKnownMarketplaces": {
    "dig": {
      "source": {
        "source": "github",
        "repo": "oslokommune/claude-marketplace"
      }
    }
  },
  "effortLevel": "xhigh",
  "enableArtifacts": false,
  "alwaysThinkingEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "awaySummaryEnabled": false
}
