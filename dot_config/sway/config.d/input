# You can get the identifiers of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.
input type:keyboard {
  xkb_layout us-julius
}

input type:pointer {
  natural_scroll disabled
  tap disabled
}

input type:touchpad {
  natural_scroll enabled
  tap enabled
}

input 76:613:Magic__Trackpad_Mouse {
  natural_scroll enabled
  tap enabled
}
